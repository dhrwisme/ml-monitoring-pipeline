# Copy to .env for local development (gitignored). Render sets these as real
# environment variables in the service's dashboard -- .env is never used there.

# Postgres connection string. Free-tier options: Neon (neon.tech) or Supabase
# (supabase.com). Render's free web services have no persistent disk, so
# prediction logging/drift/accuracy tracking need a DB that lives outside
# the container.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared secret the GitHub Actions reconcile workflow sends as
# X-Reconcile-Token to authenticate POST /monitor/reconcile. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the same value here, on Render, and as a GitHub Actions secret
# (Settings -> Secrets and variables -> Actions -> RECONCILE_TOKEN).
RECONCILE_TOKEN=change-me
